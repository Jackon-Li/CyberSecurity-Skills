{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "CyberSecurity Skills Index Schema",
  "description": "校验 index.json 的结构完整性。",
  "type": "object",
  "required": [
    "meta",
    "modules"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "description",
        "version",
        "total_skills",
        "total_modules",
        "last_updated",
        "standards"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "total_skills": {
          "type": "integer",
          "minimum": 1
        },
        "total_modules": {
          "type": "integer",
          "minimum": 1
        },
        "last_updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "source": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "name_en",
          "dir",
          "count",
          "skills"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d{2}$"
          },
          "name": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "dir": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "name_en",
                "dir",
                "path"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "name_en": {
                  "type": "string"
                },
                "dir": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "team": {
                  "type": "string",
                  "enum": [
                    "red",
                    "blue",
                    "forensic",
                    ""
                  ]
                },
                "subdomain": {
                  "type": "string"
                },
                "files": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}